{
  "name": "poedex-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PoEDex frontend workspace: the UI kit, the framework-agnostic runtime, the web surface, and every module's own UI.",
  "scripts": {
    "dev": "pnpm --filter @poedex/web dev",
    "build": "pnpm --filter @poedex/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types:check": "python3 scripts/generate_types.py --check",
    "check": "pnpm run types:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:compact",
    "test:compact": "vitest run --config vitest.compact.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-poedex": "workspace:*",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.13.1"
}
