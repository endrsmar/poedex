{
  "name": "@poedex/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Primitives with two profile implementations, selected at build time.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./steam": "./src/profiles/compact/steam.tsx",
    "./testing/decky-ui": "./src/testing/decky-ui-double.tsx",
    "./testing/gamepad": "./src/testing/gamepad-focus.ts"
  },
  "imports": {
    "#profile": {
      "poedex-compact": "./src/profiles/compact/index.tsx",
      "default": "./src/profiles/full/index.tsx"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@decky/ui": "4.12.0"
  }
}
