# Copy to .env and fill in. .env is gitignored — this repo is public, and
# scripts/deploy-deck.sh refuses to run if that ever stops being true.

DECK_IP=192.168.1.42

# Optional. Defaults to deck.
#DECK_USER=deck

# Optional. Omit it and SSH keys are used, which is the better answer:
#   ssh-copy-id deck@192.168.1.42
# A password here sits in plaintext on disk. It is supported because typing it
# forty times is worse, not because it is a good idea.
#DECK_PASSWORD=
